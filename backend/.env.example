# ---------------------------------------------------------------------------
# Backend (Python) environment.
# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored — never commit real keys.
# ---------------------------------------------------------------------------

# Supabase project API URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# service_role SECRET key — full access, bypasses RLS. SERVER-SIDE ONLY.
# Used by sync_insiders_trades.py and generate_insider_avatars.py (DB writes + storage).
# Find it: Supabase Dashboard -> Project Settings -> API -> service_role (secret)
SUPABASE_SERVICE_KEY=your-service-role-secret-key

# Publishable / anon key — read-only client used by fetch_cala.py.
SUPABASE_KEY=your-publishable-or-anon-key

# Cala API key
CALA_API_KEY=your-cala-api-key
