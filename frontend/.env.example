# ---------------------------------------------------------------------------
# Frontend (Vite) environment.
# Copy this file to frontend/.env.local and fill in real values.
# frontend/.env.local is gitignored (*.local) — never commit real keys.
#
# Only VITE_-prefixed vars are bundled into the browser. Put ONLY the
# publishable / anon key here — NEVER the service_role secret.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Node scripts in scripts/*.mjs that need the service_role secret can read it
# WITHOUT the VITE_ prefix, so it stays server-side and is never bundled:
# SUPABASE_SERVICE_KEY=your-service-role-secret-key
